# Copy this file to backend.env on the deployment server, replace every
# CHANGE_ME value, and restrict it to the deployment user with chmod 600.
# The example targets development; production must use its own project, port,
# runtime URLs, credentials, and SPRING_PROFILES_ACTIVE=prod.

# Keep the existing Compose project so the backend can reuse its Redis network.
COMPOSE_PROJECT_NAME=change_me_existing_compose_project

# Host binding
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=28081

# Deployment profile and MySQL container/application datasource
SPRING_PROFILES_ACTIVE=dev
MYSQL_ROOT_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_DATABASE=theme_database
MYSQL_ROOT_HOST=%

# Environment-specific service URLs and redirects
SERVER_EXTERNAL_DOMAIN=https://CHANGE_ME_API_DOMAIN
FILE_BASE_URL=https://CHANGE_ME_API_DOMAIN
SECURITY_ALLOWED_ORIGIN_LIST=https://CHANGE_ME_FRONTEND_DOMAIN
AUTH_OAUTH2_REDIRECT_URL=https://CHANGE_ME_FRONTEND_DOMAIN
AUTH_WITH_HTTPS=true

# Android builder and signing values required by configuration binding
THEME_ANDROID_KEY_ALIAS=CHANGE_ME_ANDROID_KEY_ALIAS
THEME_ANDROID_KEYSTORE_PASSWORD=CHANGE_ME_ANDROID_KEYSTORE_PASSWORD
THEME_ANDROID_KEY_PASSWORD=CHANGE_ME_ANDROID_KEY_PASSWORD
THEME_ANDROID_KEYSTORE_HOST_PATH=/absolute/path/to/android-signing.jks
