# Copy this file to backend.env on the development server, replace every
# CHANGE_ME value, and restrict it to the deployment user with chmod 600.

# Keep the existing Compose project so the backend can reuse its Redis network.
COMPOSE_PROJECT_NAME=change_me_existing_compose_project

# MySQL container and application datasource
SPRING_APPLICATION_NAME=komentum-service
# The dev profile runs non-idempotent demo seeders, so persistent deployments do not enable it.
SPRING_PROFILES_ACTIVE=auth
MYSQL_ROOT_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_DATABASE=theme_database
MYSQL_ROOT_HOST=%
SPRING_DATASOURCE_URL=jdbc:mysql://database:3306/theme_database
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_HIBERNATE_NAMING_PHYSICAL_STRATEGY=org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy

# Redis
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# Service URLs and local, ephemeral upload storage
SERVER_PORT=8080
SERVER_DOMAIN=https://CHANGE_ME_DEV_API_DOMAIN
SERVER_EXTERNAL_DOMAIN=https://CHANGE_ME_DEV_API_DOMAIN
FILE_BASE_URL=https://CHANGE_ME_DEV_API_DOMAIN
FILE_STORAGE=local

# Authentication and test-user credentials
JWT_SECRET=CHANGE_ME_BASE64_ENCODED_JWT_SECRET
AUTH_ACCESS_TOKEN_EXPIRES_IN=360000
AUTH_REFRESH_TOKEN_EXPIRES_IN=360000
AUTH_OAUTH2_REDIRECT_URL=https://CHANGE_ME_DEV_FRONTEND_DOMAIN
AUTH_WITH_HTTPS=true
TEST_USER_USER_EMAIL=CHANGE_ME_TEST_USER_EMAIL
TEST_USER_PASSWORD=CHANGE_ME_TEST_USER_PASSWORD
TEST_USER_PUBLIC_USER_ID=CHANGE_ME_TEST_USER_PUBLIC_UUID

# Kakao OAuth
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_CLIENT_ID=CHANGE_ME_KAKAO_CLIENT_ID
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_CLIENT_SECRET=CHANGE_ME_KAKAO_CLIENT_SECRET
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_REDIRECT_URI=https://CHANGE_ME_DEV_API_DOMAIN/login/oauth2/code/kakao
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_CLIENT_AUTHENTICATION_METHOD=client_secret_post
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_AUTHORIZATION_GRANT_TYPE=authorization_code
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_SCOPE=profile_nickname,profile_image,account_email
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KAKAO_CLIENT_NAME=kakao
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_KAKAO_AUTHORIZATION_URI=https://kauth.kakao.com/oauth/authorize
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_KAKAO_TOKEN_URI=https://kauth.kakao.com/oauth/token
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_KAKAO_USER_NAME_ATTRIBUTE=id

# Public endpoints and CORS. Only the health endpoint is exposed by Actuator.
SECURITY_WHITE_LIST=/api/auth/local/sign-up,/api/auth/local/sign-in,/login/oauth2/**,/api/auth/reissue
SECURITY_WHITE_LIST_GET=/actuator/health
SECURITY_ALLOWED_ORIGIN_LIST=https://CHANGE_ME_DEV_FRONTEND_DOMAIN
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_ENDPOINT_HEALTH_SHOW_COMPONENTS=never
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

# APK generation is intentionally unavailable on the ARM64 development server.
# These non-secret placeholders only satisfy the existing validated properties.
THEME_ANDROID_DOCKER_IMAGE=disabled
THEME_ANDROID_DOCKER_TAG=disabled
THEME_ANDROID_SIGNING_KEY_ALIAS=disabled
THEME_ANDROID_SIGNING_KEYSTORE_PASSWORD=disabled
THEME_ANDROID_SIGNING_KEY_PASSWORD=disabled
THEME_ANDROID_SIGNING_KEYSTORE_HOST_PATH=/nonexistent/android-signing-disabled.jks
